  "editZones": {
    "about": "Where an edit lands decides what proves it (AGENTS.md, docs/agents/CORE.md). The guard's report lists every changed file's zone and the core functions it touches.",
    "free": {
      "why": "new files, catalog data and docs: no core function owns them, tier 0 is enough",
      "examples": [
        "docs/**",
        "src/content/gallery.ts",
        "public/modes/*.webp"
      ]
    },
    "core": {
      "why": "a file a core function owns (coreFunctions[].code): tier 0, plus that function's smoke blocks in npm run guard:browser"
    },
    "guarded": {
      "from": "hubFiles",
      "why": "most of the suite imports these: a change requires tier 2 (npm run test:ci and the four smoke shards)"
    },
    "protected": {
      "from": "scripts/agent/protected.json",
      "why": "owner review required: reported (a warning, an annotation in CI), never a failure"
    }
  }
