    "src/components/simulator/Canvas.tsx",
    "src/components/simulator/Simulator.tsx",
    "messages/*.json"
  ],
  "escalation": [
    {
      "id": "fight-league",
      "when": [
        "src/**/fightLeague*",
        "src/**/FightLeague*",
        "src/**/fightLeague/**",
        "src/lib/physics/modes/fightLeagueRows/**",
        "tests/flBalance.ts",
        "tests/flProbes.ts"
      ],
      "reason": "Fight League changed: the three balance files (every fighter 25-75 %, the median fight 12-25 s) and its smoke block",
      "tests": [
        "tests/fightLeagueBalanceGames.test.ts",
        "tests/fightLeagueBalanceMovies.test.ts",
        "tests/fightLeagueBalanceComicsAnimeShows.test.ts"
      ],
      "smoke": [
        "fight-league"
      ]
    },
    {
      "id": "paywall-watermark",
      "when": [
        "src/lib/billing/**",
        "src/lib/watermark/**",
        "src/lib/recording/**"
      ],
      "reason": "billing, the watermark or recording changed: the paywall and watermark smoke blocks",
      "smoke": [
        "paywall-gate",
        "free-watermark",
        "watermark-everywhere"
      ]
    },
    {
      "id": "desktop",
      "when": [
        "src/lib/desktop/**",
        "desktop/**",
        "src/components/simulator/desktop/**"
      ],
      "reason": "the desktop bridge or app changed: the desktop smoke blocks",
      "smoke": [
        "desktop-exe",
        "desktop-current",
        "desktop-ai-fix"
      ]
    }
  ],
  "modeFileGlobs": [
    "src/lib/physics/modes/**",
    "src/lib/physics/*.ts",
    "src/components/simulator/*Renderer.ts",
    "src/components/simulator/sections/*.tsx"
