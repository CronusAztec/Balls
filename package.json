{
  "name": "jumpingballslive",
  "version": "1.0.0",
  "private": true,
  "description": "JumpingBallsLive \u2013 free browser-based ball physics simulator for TikTok, Reels and Shorts, exported as a static site for GitHub Pages",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postexport.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-test.mjs",
    "previews": "node scripts/generate-mode-previews.mjs"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "next": "15.5.26",
    "next-intl": "^4.14.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
