{
  "name": "jumpingballslive",
  "version": "1.16.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "JumpingBallsLive – free browser-based ball physics simulator for TikTok, Reels and Shorts, exported as a static site for GitHub Pages",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postexport.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "node scripts/test-ci.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "previews": "node scripts/generate-mode-previews.mjs",
    "og:cards": "node scripts/generate-og-cards.mjs",
    "bot": "node scripts/viral-bot.mjs",
    "agent": "node scripts/agent/cli.mjs",
    "agent:mcp": "node scripts/agent/mcp.mjs",
    "blueprints:docs": "node scripts/agent/blueprint-docs.mjs",
    "go-live": "node scripts/go-live.mjs",
    "go-live:check": "node scripts/go-live-check.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "release:desktop": "node scripts/release/desktop-version.mjs",
    "changelog": "node scripts/changelog.mjs --write",
    "changelog:check": "node scripts/changelog.mjs --check",
    "trends": "node scripts/trends.mjs",
    "guard": "node scripts/agent/guard.mjs",
    "guard:browser": "node scripts/agent/guard.mjs --browser"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "next": "15.5.26",
    "next-intl": "^4.14.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "javascript-obfuscator": "^4.2.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
