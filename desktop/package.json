{
  "name": "jumpingballslive-desktop",
  "productName": "JumpingBallsLive",
  "version": "1.0.2",
  "private": true,
  "description": "JumpingBallsLive for Windows: the whole simulator in a desktop app, with GPU video rendering and a built-in AI studio",
  "author": "JumpingBallsLive",
  "license": "UNLICENSED",
  "homepage": "https://cronusaztec.github.io/Balls/",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "site": "node scripts/build-site.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "pack": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "node-llama-cpp": "^3.22.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
