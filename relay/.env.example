# JumpingBallsLive publish relay – copy to relay/.env (git-ignored) or set these in your host's dashboard.
# Never commit real values. See relay/README.md for every step.

# --- the relay itself
# The public HTTPS address of this relay (OAuth redirect URIs and the public clip URLs are built from it).
RELAY_PUBLIC_URL=https://my-relay.onrender.com
# Sites allowed to call the relay from the browser (comma-separated origins, no paths). The GitHub Pages site:
RELAY_ALLOWED_ORIGINS=https://jumpingballslive.com,https://www.jumpingballslive.com,http://localhost:3000
# Creates access keys (POST /api/keys). A long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RELAY_ADMIN_KEY=
# Where keys, accounts (with their tokens) and uploaded clips are kept. Use a persistent disk on your host.
RELAY_DATA_DIR=./relay-data
# Optional: the port (most hosts set PORT), the upload limit and how long clips stay reachable.
# PORT=8787
# RELAY_MAX_UPLOAD_MB=300
# RELAY_MEDIA_TTL_HOURS=24

# --- user accounts: anyone can sign up on the site's Account page (email + password) and connect their own TikTok,
# Instagram and YouTube accounts; a session token then acts as that user's access key. off = no new accounts (existing ones
# and access keys keep working).
# RELAY_SIGNUP=on
# How long a sign-in lasts, in days (a user signs in again after that).
# RELAY_SESSION_DAYS=30
# The sign-up and sign-in limits go by the visitor's address. Behind a proxy that is not the socket's address:
# on Render set the header Cloudflare writes (it overwrites what a caller sends), on Fly.io use Fly-Client-IP.
# RELAY_CLIENT_IP_HEADER=CF-Connecting-IP
# Without a header the relay counts X-Forwarded-For from the right: how many proxies append to it (Render: 2). Never the leftmost entry.
# RELAY_PROXY_HOPS=1
# 0 = ignore all of these and use the socket's address (the relay reached directly, no proxy in front).
# RELAY_TRUST_PROXY=1
# The Windows app's own origin (app://jumpingballslive) is always allowed to call the relay. 0 = not.
# RELAY_ALLOW_APP=1

# --- TikTok (developers.tiktok.com: Login Kit + Content Posting API, Direct Post)
# Redirect URI to register: <RELAY_PUBLIC_URL>/oauth/tiktok/callback – scopes: user.info.basic, video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# file (default: the relay uploads the clip in chunks) or pull (TikTok downloads <RELAY_PUBLIC_URL>/media/…; verify
# the domain as a URL prefix in the developer portal first).
# TIKTOK_SOURCE=file
# An unaudited app may only post privately: by default such posts go out as "Only me" with a note. 0 = fail instead.
# TIKTOK_PRIVATE_FALLBACK=1

# --- Instagram (developers.facebook.com: a Business app)
# Redirect URI to register: <RELAY_PUBLIC_URL>/oauth/instagram/callback
IG_APP_ID=
IG_APP_SECRET=
# facebook (default): Facebook Login for Business – instagram_basic, instagram_content_publish, pages_show_list,
#   pages_read_engagement, business_management; the Instagram professional account must be linked to a Facebook Page.
# instagram: the Instagram API with Instagram Login – instagram_business_basic, instagram_business_content_publish
#   (use the Instagram app ID and secret of the app's "Instagram" product).
# IG_LOGIN=facebook
# Optional: a Facebook Login for Business configuration ID (instead of the scope list) and the Graph API version.
# IG_CONFIG_ID=
# IG_GRAPH_VERSION=v23.0

# --- YouTube through the relay (console.cloud.google.com: an OAuth client of type "Web application")
# Redirect URI to register: <RELAY_PUBLIC_URL>/oauth/youtube/callback – scopes: youtube.upload, youtube.readonly
# (The site can also upload to YouTube straight from the browser without the relay – see the main README.)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
