# The relay on a VPS (relay/deploy, README "Run it on a VPS"). install.sh writes .env from the first three lines once and never
# overwrites it afterwards; the platform keys below are yours to add, then `docker compose up -d` in this folder.

# The name the relay answers on: a DNS record (A, DNS only) must point it at this server.
RELAY_DOMAIN=relay.example.com
# The address OAuth sign-ins and clip links are built from.
RELAY_PUBLIC_URL=https://relay.example.com
# The sites allowed to call the relay from the browser (comma-separated origins, no paths). The Windows app is always allowed.
RELAY_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional: take no new accounts (existing users keep working).
# RELAY_SIGNUP=off
# Optional: an admin key creates access keys (POST /api/keys). A long random string.
# RELAY_ADMIN_KEY=

# The platform apps (relay/README.md, "Setting up the platform apps"). Redirect URIs: <RELAY_PUBLIC_URL>/oauth/<platform>/callback
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# IG_APP_ID=
# IG_APP_SECRET=
# YT_CLIENT_ID=
# YT_CLIENT_SECRET=
