# Public site URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: forward feedback submissions to a webhook (Slack, Discord, Zapier, your own API...).
# When unset, feedback is appended to ./data/feedback.jsonl on the server.
# FEEDBACK_WEBHOOK_URL=https://hooks.example.com/feedback

# Optional: privacy-friendly analytics script (e.g. Plausible, Umami, Rybbit).
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
# NEXT_PUBLIC_ANALYTICS_SITE_ID=your-site-id
