# Public site URL used for canonical links, hreflang, sitemap and Open Graph. Include the sub-folder
# when the site is not served from the domain root. When unset it defaults to http://localhost:3000
# plus NEXT_PUBLIC_BASE_PATH; the GitHub Pages workflow sets it from the repository's Pages settings.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000/Balls

# Sub-folder the site is served from, e.g. "/Balls" for https://<user>.github.io/Balls.
# Leave empty for a root deployment (custom domain or <user>.github.io repository).
NEXT_PUBLIC_BASE_PATH=

# Feedback delivery (the site is static, so the browser sends it). The first one set wins:
# 1. any endpoint that accepts a cross-origin JSON POST from the site (Formspree, Basin, a Cloudflare
#    Worker, your own API...). Self-hosted endpoints must answer the CORS preflight with
#    Access-Control-Allow-Origin and Access-Control-Allow-Headers: Content-Type.
# NEXT_PUBLIC_FEEDBACK_ENDPOINT=https://formspree.io/f/your-form-id
# 2. an email address (opens the visitor's email app with the message prefilled)
# NEXT_PUBLIC_FEEDBACK_EMAIL=you@example.com
# 3. a GitHub repository: opens a prefilled "new issue" form. Only works for a PUBLIC repository with
#    Issues enabled, and visitors need a GitHub account. The workflow sets it automatically when so.
# NEXT_PUBLIC_GITHUB_REPO=owner/repo

# Optional: privacy-friendly analytics script (e.g. Plausible, Umami, Rybbit).
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://analytics.example.com/script.js
# NEXT_PUBLIC_ANALYTICS_SITE_ID=your-site-id

# --- viral-bot --- Posting the bot's clips to Instagram (scripts/viral-bot.mjs --post / --post-only; README, "Viral video bot").
# Never commit real values: keep them in .env.local (git-ignored) or, for the scheduled job, in repository secrets.
# The Instagram professional account's user id and a long-lived token with instagram_basic + instagram_content_publish:
# IG_USER_ID=17841400000000000
# IG_ACCESS_TOKEN=
# The public HTTPS folder the rendered clips are uploaded to (Instagram downloads each MP4 from here):
# BOT_VIDEO_BASE_URL=https://cdn.example.com/bot
# Optional: the Graph API version and host (https://graph.instagram.com for Instagram Login tokens).
# IG_GRAPH_VERSION=v23.0
# IG_GRAPH_HOST=https://graph.facebook.com
